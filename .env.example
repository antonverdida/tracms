# Generate an URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-64-character-hex-password
SECRET_KEY_BASE=replace-with-the-output-of-mix-phx-gen-secret
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000
# For a separate official website, enter its exact origin, for example https://tracms.deped.gov.ph
API_ALLOWED_ORIGINS=
PUBLIC_API_RATE_LIMIT=60
PUBLIC_API_RATE_WINDOW_MS=60000
