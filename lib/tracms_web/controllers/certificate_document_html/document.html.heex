<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Printable TRACMS certificate document for DepEd Region IX training records."
    />
    <title>{@page_title} · TRACMS</title>
    <link rel="stylesheet" href={url(~p"/assets/css/app.css")} />
    <script defer type="text/javascript" src={url(~p"/assets/js/app.js")}>
    </script>
  </head>
  <body class="certificate-document-page" data-certificate-autoprint={to_string(@autoprint)}>
    <div class="certificate-document-shell">
      <header class="certificate-document-toolbar">
        <div class="certificate-document-toolbar-copy">
          <p class="certificate-document-eyebrow">Official certificate document</p>
          <h1 class="certificate-document-title">
            {@certificate.registration.training_activity.title}
          </h1>
          <p class="certificate-document-meta">
            Certificate No. {@certificate.certificate_number} • Issued {format_date(
              @certificate.issued_on
            )}
          </p>
        </div>

        <div class="certificate-document-actions">
          <.button
            :if={@back_path}
            href={@back_path}
            variant="ghost"
          >
            {@back_label}
          </.button>
          <.button type="button" variant="secondary" data-print-certificate>
            Print certificate
          </.button>
          <.button :if={@export_path} href={@export_path} variant="primary">
            Export document
          </.button>
        </div>
      </header>

      <main class="certificate-document-content">
        <.certificate_sheet
          certificate={@certificate}
          participant_name={@participant_name}
          issued_by_name={@issued_by_name}
          scope_label={@scope_label}
          layout_settings={@layout_settings}
        />

        <section class="certificate-document-note">
          <div class="certificate-document-note-icon">
            <.icon name="hero-shield-check" class="size-5" />
          </div>
          <div>
            <p class="certificate-document-note-title">Government record notice</p>
            <p class="certificate-document-note-copy">
              This document is generated from the DepEd Region IX TRACMS portal for official training record purposes.
            </p>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
