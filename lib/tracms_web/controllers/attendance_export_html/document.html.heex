<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@page_title}</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <style>
      body {
        padding: 2rem;
        background: #ffffff;
      }

      .attendance-export-shell {
        display: grid;
        gap: 1.5rem;
      }

      .attendance-export-meta {
        color: #526072;
        font-size: 0.95rem;
      }

      .attendance-export-table th,
      .attendance-export-table td {
        white-space: normal;
      }
    </style>
  </head>
  <body>
    <main class="attendance-export-shell">
      <header>
        <p class="eyebrow">TRACMS Attendance Export</p>
        <h1 class="portal-page-title">List of Attendance</h1>
        <p :if={@training_activity} class="attendance-export-meta">
          {@training_activity.title}
        </p>
        <p class="attendance-export-meta">
          Exported on {format_datetime(@exported_at)}.
        </p>
      </header>

      <div class="data-table-wrap attendance-export-table">
        <table class="data-table">
          <thead>
            <tr>
              <th>Participant Name</th>
              <th>Organization</th>
              <th>Registration Status</th>
              <th>Attendance Status</th>
              <th>Time Recorded</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={entry <- @entries}>
              <td>{participant_name(entry)}</td>
              <td>{organization_name(entry)}</td>
              <td>{registration_status_label(entry.registration.status)}</td>
              <td>{attendance_status_label(entry)}</td>
              <td>{recorded_at_label(entry)}</td>
              <td>{remarks_label(entry)}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
