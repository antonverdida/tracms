<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="page-grid">
    <section id="overview" class="hero-grid">
      <article class="hero-card hero-main">
        <div class="hero-kicker">
          <span>DepEd Region IX</span>
          <span>•</span>
          <span>TRACMS</span>
        </div>

        <h1 class="hero-title">Training management for DepEd Region IX.</h1>

        <p class="hero-lead">
          TRACMS manages training activities, registration, attendance, and certification in one
          regional system.
        </p>

        <div class="hero-actions">
          <%= if @current_scope && @current_scope.user do %>
            <.button navigate={~p"/dashboard"}>Open dashboard</.button>
          <% else %>
            <.button navigate={~p"/users/log-in"}>Sign in</.button>
          <% end %>
        </div>
      </article>

      <aside class="stack">
        <article class="panel panel-muted">
          <p class="eyebrow">Access</p>
          <h2 class="section-title">Internal regional platform</h2>
          <p class="section-copy">
            This system is intended for authorized DepEd Region IX users and training participants.
          </p>
        </article>
      </aside>
    </section>

    <section class="panel" id="modules">
      <p class="eyebrow">What TRACMS covers</p>
      <div class="feature-grid mt-6">
        <div class="feature-card">
          <h3 class="feature-title">Training activities</h3>
          <p class="feature-copy">Planning, approval, publication, and schedules.</p>
        </div>
        <div class="feature-card">
          <h3 class="feature-title">Registration</h3>
          <p class="feature-copy">Participant sign-up and review workflow.</p>
        </div>
        <div class="feature-card">
          <h3 class="feature-title">Attendance</h3>
          <p class="feature-copy">Attendance capture and completion tracking.</p>
        </div>
        <div class="feature-card">
          <h3 class="feature-title">Certificates</h3>
          <p class="feature-copy">Issuance and verification-ready records.</p>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
