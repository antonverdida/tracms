<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  variant="dashboard"
  active_nav="dashboard"
>
  <div class="dashboard-portal">
    <section class="dashboard-portal-hero">
      <div class="dashboard-portal-hero-copy">
        <p class="eyebrow">{@dashboard_role_label}</p>
        <h1 class="dashboard-portal-title">Good Morning, {@greeting_name}</h1>
        <p class="dashboard-portal-copy">
          Quick access to your current trainings, participant activity, attendance progress, and certificate generation.
        </p>
      </div>

      <div class="dashboard-date-pill">
        <.icon name="hero-calendar-days" class="size-5" />
        <span>{@dashboard_date}</span>
      </div>
    </section>

    <section class="dashboard-stat-grid">
      <article
        :for={metric <- @metrics}
        class={["dashboard-stat-card", "dashboard-stat-card-#{metric.tone}"]}
      >
        <div class={["dashboard-stat-icon", "dashboard-stat-icon-#{metric.tone}"]}>
          <.icon name={metric.icon} class="size-7" />
        </div>

        <div class="dashboard-stat-content">
          <p class="dashboard-stat-label">{metric.label}</p>
          <p class="dashboard-stat-value">{metric.value}</p>
          <p :if={metric.meta && metric.meta != ""} class="dashboard-stat-meta">{metric.meta}</p>
        </div>
      </article>
    </section>

    <section class="panel portal-list-panel">
      <div class="dashboard-section-head">
        <div class="dashboard-section-copy-block">
          <p class="eyebrow">Upcoming trainings</p>
          <h2 class="section-title">Upcoming Trainings</h2>
          <p class="dashboard-section-copy">
            Scheduled and near-term trainings that need manager visibility.
          </p>
        </div>

        <.link navigate={~p"/trainings"} class="dashboard-panel-link">
          View all trainings
        </.link>
      </div>

      <%= if @upcoming_trainings == [] do %>
        <.portal_empty_state
          icon="hero-calendar-days"
          title="No upcoming trainings scheduled yet"
          copy="Once a training has a current or future schedule, it will appear here for quick review."
        >
          <:actions>
            <.link
              navigate={~p"/trainings/new"}
              class="portal-link-button portal-link-button-primary"
            >
              Add training
            </.link>
          </:actions>
        </.portal_empty_state>
      <% else %>
        <div class="data-table-wrap dashboard-table-wrap">
          <table class="data-table portal-table">
            <thead>
              <tr>
                <th>Training Title</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Registered</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={training <- @upcoming_trainings}>
                <td>
                  <div class="dashboard-record-stack">
                    <.link
                      navigate={training.action_path}
                      class="portal-table-link dashboard-record-link"
                    >
                      {training.title}
                    </.link>
                    <span class="dashboard-record-meta">{training.venue}</span>
                  </div>
                </td>
                <td class="dashboard-date-cell">{training.schedule}</td>
                <td class="dashboard-muted-cell">{training.venue}</td>
                <td class="dashboard-number-cell">{training.registered_count}</td>
                <td>
                  <span class={["portal-chip", "portal-chip-#{training.status_tone}"]}>
                    {training.status_label}
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="dashboard-content-grid">
      <article class="panel portal-list-panel dashboard-recent-panel">
        <div class="dashboard-section-head">
          <div class="dashboard-section-copy-block">
            <p class="eyebrow">Recent registrations</p>
            <h2 class="section-title">Recent Registrations</h2>
            <p class="dashboard-section-copy">
              The latest participant submissions that may need review or follow-up.
            </p>
          </div>

          <.link navigate={~p"/registrations"} class="dashboard-panel-link">
            View registrations
          </.link>
        </div>

        <%= if @recent_registrations == [] do %>
          <div class="portal-empty-quiet">
            <p class="section-copy">
              Newly submitted participant registrations will appear here.
            </p>
          </div>
        <% else %>
          <div class="data-table-wrap dashboard-table-wrap">
            <table class="data-table portal-table">
              <thead>
                <tr>
                  <th>Participant</th>
                  <th>Training</th>
                  <th>Registration Date</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={registration <- @recent_registrations}>
                  <td>
                    <span class="dashboard-record-name">{registration.participant_name}</span>
                  </td>
                  <td>
                    <.link
                      navigate={registration.action_path}
                      class="portal-table-link dashboard-record-link"
                    >
                      {registration.training_title}
                    </.link>
                  </td>
                  <td class="dashboard-date-cell">{registration.registration_date}</td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
      </article>

      <article class="panel portal-list-panel dashboard-recent-panel">
        <div class="dashboard-section-head">
          <div class="dashboard-section-copy-block">
            <p class="eyebrow">Recent certificates</p>
            <h2 class="section-title">Recent Certificates Generated</h2>
            <p class="dashboard-section-copy">
              Recently issued certificates so managers can confirm output at a glance.
            </p>
          </div>

          <.link navigate={~p"/certificates"} class="dashboard-panel-link">
            View certificates
          </.link>
        </div>

        <%= if @recent_certificates == [] do %>
          <div class="portal-empty-quiet">
            <p class="section-copy">
              Generated certificate records will appear here once certificates are issued.
            </p>
          </div>
        <% else %>
          <div class="data-table-wrap dashboard-table-wrap">
            <table class="data-table portal-table">
              <thead>
                <tr>
                  <th>Participant</th>
                  <th>Training</th>
                  <th>Certificate No.</th>
                  <th>Generated On</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={certificate <- @recent_certificates}>
                  <td>
                    <span class="dashboard-record-name">{certificate.participant_name}</span>
                  </td>
                  <td>
                    <.link
                      navigate={certificate.action_path}
                      class="portal-table-link dashboard-record-link"
                    >
                      {certificate.training_title}
                    </.link>
                  </td>
                  <td>
                    <span class="dashboard-cert-number">{certificate.certificate_number}</span>
                  </td>
                  <td class="dashboard-date-cell">{certificate.generated_on}</td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
      </article>
    </section>

    <section class="panel portal-list-panel">
      <div class="dashboard-section-head">
        <div class="dashboard-section-copy-block">
          <p class="eyebrow">Quick actions</p>
          <h2 class="section-title">Quick Actions</h2>
          <p class="dashboard-section-copy">
            Start the most common training-management tasks without leaving the overview page.
          </p>
        </div>
      </div>

      <div class="portal-action-grid dashboard-quick-actions">
        <.link :for={action <- @quick_actions} navigate={action.path} class="portal-action-tile">
          <div class={["portal-action-icon", "portal-action-icon-#{action.tone}"]}>
            <.icon name={action.icon} class="size-6" />
          </div>
          <div>
            <h3 class="portal-action-title">{action.title}</h3>
            <p class="portal-action-copy">{action.copy}</p>
          </div>
        </.link>
      </div>
    </section>

    <footer class="dashboard-portal-footer">
      <span>
        &copy; {@current_year} Department of Education - Region IX. All rights reserved.
      </span>
      <span>TRACMS Version 1.0.0</span>
    </footer>
  </div>
</Layouts.app>
