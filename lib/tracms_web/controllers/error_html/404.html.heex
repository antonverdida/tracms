<main class="grid min-h-screen place-items-center bg-[var(--tracms-bg)] px-6 py-16 text-[var(--tracms-text)]">
  <section class="w-full max-w-xl rounded-[var(--tracms-radius-lg)] border border-[var(--tracms-border)] bg-[var(--tracms-surface)] p-8 text-center shadow-[var(--tracms-shadow-md)] sm:p-12">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mx-auto mt-4 max-w-md text-base leading-7 text-[var(--tracms-text-muted)]">
      The page you requested does not exist or may no longer be available.
    </p>
    <a href={~p"/users/log-in"} class="btn-base btn-primary mt-8">Go to sign in</a>
  </section>
</main>
